PORT=8085
APP_VERSION=1.0.0
APP_URL=http://localhost:8085
NODE_ENV=development

# Logging Configuration / trace <-- debug <-- info <-- warn <-- error <-- fatal <-- silent /
LOG_LEVEL=info
LOG_FILE_LIMIT=5
LOG_FILE_SIZE=15m
LOG_FILE=./logs/metbot.log

# Database Configuration 
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public

# Gemini API Key (Required for Gemini services)
GEMINI_API_KEY=your-api-key-here
GEMINI_API_KEY_ENABLE=true
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MEDIUM
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING=true

# OpenAI API Key (Required for OpenAI endpoints)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_KEY_ENABLE=true
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_THINKING=true

#langsmith free version for high-level agentic tracking
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-api-key-here
LANGSMITH_PROJECT=metbot

# RAG (Retrieval-Augmented Generation) Configuration
RAG_API_KEY=your-api-key-here
RAG_API_URL=your-api-url-here

# Assets Signing Secret
ASSETS_SIGNING_SECRET="your_signing_secret_here"

#Agent-Tool management

TOOL_TIME_OUT_MS= 50000
TOOL_FAILURE_LIMIT= 2
TOOL_CALL_LIMIT= 8
AGENT_CALL_LIMIT= 12
AGENT_RECURSION_LIMIT= 80
THINKING=<true|false>

# Preload Configuration
CATALOG_CACHE_VALID_TIME_LIMIT= 15 * 60 * 1000
DEFAULT_PRELOADED_EXCERPTS= 3

# OPTIONAL: Global test configuration

CLIENT_TEST_APP_CLIENT_ID=<client-app-id>
CLIENT_TEST_USER_ID=<client-user-id>
CLIENT_TEST_AUTHORIZATION=<client-token-here>
CLIENT_TEST_SCOPES=superset_mcp.pay_api
CLIENT_TEST_SUBDOMAINS=superset.general&pay.personas
CLIENT_TEST_MODES=superset.advance.guided&pay
CLIENT_TEST_MODEL=gemini-3.5-flash-lite 

## For Superset
SUPERSET_TEST_DASHBOARD_ID=154
SUPERSET_TEST_BASE_DASHBOARD_ID=155

# Encryption key for sentitives
CREDS_KEY=your-32-byte-long-encryption-key-here

#Summarization

SUMMARY_AGENT=gemini
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_REMAINING_MESSAGES=6
SUMMARY_MAX_WORDS=300