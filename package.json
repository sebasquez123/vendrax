{
  "name": "metbot",
  "version": "1.0.0",
  "description": "",
  "author": "Metgroup",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "apikey:rotate": "ts-node src/shared/services/crypto/crypto.ts rotate",
    "crypto:encrypt": "ts-node src/shared/services/crypto/crypto.ts encrypt",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate --dataSource src/data-source.ts",
    "prepare": "husky install",
    "eslint": "eslint \"{src,tests}/**/*.{ts,tsx}\"",
    "prettier:check": "prettier --check \"{src,tests}/**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"{src,tests}/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:agent": "ts-node --transpile-only tests/run.ts",
    "test:agent:superset": "ts-node --transpile-only tests/run.ts --service SUPERSET",
    "test:agent:superset:productive": "ts-node --transpile-only tests/run.ts --service SUPERSET --catalog productive",
    "test:agent:pay": "ts-node --transpile-only tests/run.ts --service PAY",
    "typecheck": "tsc --project tsconfig.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource ./src/data-source.ts",
    "codegraph": "codegraph init",
    "format": "npm run typecheck && npm run prettier:check && npm run eslint"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "@google/genai": "^2.10.0",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/apollo": "^12.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.27",
    "@xenova/transformers": "^2.17.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fetch": "^1.1.0",
    "kleur": "^4.1.5",
    "langchain": "^1.5.2",
    "nestjs-i18n": "^10.8.5",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^1.1.0",
    "typeorm-transactional": "^0.5.0",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/axios": "^0.14.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-unicorn": "^52.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
